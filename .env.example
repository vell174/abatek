# === Обязательные ===
# Домен сайта (DNS A-записи @, www и mail должны указывать на IP VPS)
SITE_DOMAIN=abatek74.ru

# E-mail для уведомлений Let's Encrypt (тот же системный ящик admin@)
ACME_EMAIL=admin@abatek74.ru

# Basic Auth для доступа ко всему сайту
BASIC_AUTH_USER=1111
BASIC_AUTH_PASSWORD=1111
BASIC_AUTH_HASH={SHA}ARyUXzDOLLr8RS85hA8CVpMznEI=

# Пароль БД PostgreSQL (длинный случайный; только буквы и цифры —
# символы @ : / # сломают строку подключения postgres://)
POSTGRES_PASSWORD=dffddSdfe4433AAAA

# === Почта (опционально) ===
# Тип SSL для mailserver: пусто = self-signed (хватает для внутренней отправки).
MAIL_SSL_TYPE=

# === Необязательные (есть дефолты) ===
# Пользователь и имя БД PostgreSQL (по умолчанию abatek/abatek)
POSTGRES_USER=abatek
POSTGRES_DB=abatek

# Адреса почты: от кого шлёт сайт и куда падают заявки
# (по умолчанию site@SITE_DOMAIN и zakaz@SITE_DOMAIN)
MAIL_FROM=site@abatek74.ru
MAIL_TO=zakaz@abatek74.ru

# Системный ящик: postmaster, bounce-уведомления почтовика, письма Let's Encrypt
# (по умолчанию admin@SITE_DOMAIN)
MAIL_ADMIN=admin@abatek74.ru
